{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel",
  "version": "1.2.7",
  "identifier": "com.kestrel.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Kestrel",
    "copyright": "Copyright © 2026 Kestrel",
    "category": "Utility",
    "shortDescription": "Instant file search and launcher",
    "longDescription": "Kestrel 是一款极速文件搜索与应用启动器，双击 Ctrl 即可瞬时定位文件、启动应用、执行命令。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}